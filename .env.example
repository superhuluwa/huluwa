# ===== 葫芦娃助手 部署配置（CentOS + Docker） =====
# 复制为 .env 后按需修改：cp .env.example .env

# 监听地址：初始化完成前保持 127.0.0.1，完成管理员初始化后再改为 0.0.0.0
HULUWA_BIND_ADDRESS=127.0.0.1
HULUWA_PORT=8089

# 宿主机 Docker socket 的组 ID（必填，否则容器内 docker-java 无权访问 socket）
# 获取命令：stat -c '%g' /var/run/docker.sock
# CentOS 常见值：root:docker -> 999；root:dockerroot -> 994
DOCKER_GID=999
