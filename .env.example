# ===== 葫芦娃助手 部署配置（CentOS + Docker） =====
# 复制为 .env 后按需修改：cp .env.example .env

# 监听地址：初始化完成前保持 127.0.0.1，完成管理员初始化后再改为 0.0.0.0
HULUWA_BIND_ADDRESS=127.0.0.1
HULUWA_PORT=8000

# 数据目录（宿主机路径，挂载到容器 /app/data，存放 SQLite 与管理配置）
HULUWA_DATA_DIR=./data

# 新下载固定共用 /vol1/1000/downloads，并在容器内映射到同一路径。
# 正式文件保存到 /vol1/1000/downloads/剧名，不追加年份和季号文件夹。
# 容器 UID 10001 需要下载目录写权限，飞牛影视需要该目录的访问授权。
# 临时分片、合并视频和日志位于容器 /app/.huluwa-work，不挂载宿主机，删除容器即清除。
# 空闲时每小时清理，日志默认保留 7 天（最少 1 天）；无关联任务目录直接回收。
HULUWA_HLS_LOG_RETENTION_DAYS=7

# 以下变量只用于保留旧版本 /media 下的历史文件与日志，容器只读挂载。
HULUWA_MEDIA_DIR=./data/media

# 宿主机 /var/run/docker.sock 的组 ID（不填则 Docker 管理页无法连接守护进程）
# 获取命令：stat -c '%g' /var/run/docker.sock
# CentOS 常见值：root:docker -> 999；root:dockerroot -> 994
DOCKER_GID=999

# Frp 管理：frpc 容器的配置目录（挂载到容器 /app/frp）
# 葫芦娃与 frpc 共用同一文件，保存后热加载即时生效。
# 飞牛：/vol1/1000/docker/frpc（frpc compose 所在目录；frpc 侧必须目录挂载）
# CentOS：/root/frp
HULUWA_FRP_DIR=/root/frp

# 数据目录权限：镜像内进程为 10001:10001，绑定挂载时该目录需归其所有。
# 一键脚本会自动 chown，手工部署请执行：chown -R 10001:10001 <HULUWA_DATA_DIR>
