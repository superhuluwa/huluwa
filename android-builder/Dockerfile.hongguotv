FROM huluwa-android-builder:debian
USER 0:0
# 红果 TV 的 core 模块声明 jvmToolchain(17)，基础镜像只带 JDK 21。
# 预装 JDK 17 供 Gradle 工具链自动检测，避免构建时联网下载或改写源码。
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*
COPY agent.py worker.py process_tree.py android.init.gradle hongguotv.init.gradle git-askpass.py /opt/builder/
RUN sed -i 's/\r$//' /opt/builder/*.py && chmod 755 /opt/builder/git-askpass.py
ENV HULUWA_ANDROID_PACKAGE=com.huluwa.nativeapp \
    HULUWA_ANDROID_ARTIFACT_PREFIX=hongguotv \
    HULUWA_ANDROID_APP_DIRECTORY=kotlin-tv \
    HULUWA_ANDROID_APP_NAME=hongguotv
USER 10001:10001
